# --- secrets (NEVER commit) ---
.env
.env.*
*.key

# --- databases / runtime data ---
# NOTE: `data/` must stay ANCHORED (leading slash). A bare `data/` also matches the
# SOURCE package `quantdesk/data/`, which silently excluded the entire data layer from
# every release up to v7.8. Do not un-anchor it.
*.db
*.db-wal
*.db-shm
/data/
backups/
plots/

# --- app runtime artifacts ---
quantdesk_data.db
strategies/
indicator_presets/
.master_cache/
.workflow/*.log
.workflow/*.tmp
.workflow/*.jsonl
.workflow/modular.lock

# --- python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# --- os ---
.DS_Store
Thumbs.db
